{
  "openapi": "3.1.0",
  "info": {
    "title": "Postmark selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.postmarkapp.com"
    }
  ],
  "paths": {
    "/deliverystats": {
      "get": {
        "operationId": "postmark_get_delivery_stats",
        "summary": "Read outbound delivery statistics without exposing the server API token configuration.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/email": {
      "post": {
        "operationId": "postmark_send_email",
        "summary": "Submit one transactional message; inspect ErrorCode/MessageID and subsequent delivery events.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "From": {
                    "type": "string",
                    "format": "email"
                  },
                  "To": {
                    "type": "string",
                    "format": "email"
                  },
                  "Subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "TextBody": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "From",
                  "To",
                  "Subject",
                  "TextBody"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Postmark-Server-Token"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
